<%- include('partials/head') %>
<div class="login-wrap">
  <div class="card login-card">
    <h1>Forgot password</h1>
    <% if (sent) { %>
      <p class="sub">If that email belongs to an admin account, we've sent a reset link to it. The link expires in 1 hour.</p>
      <p class="login-links"><a href="/admin/login">Back to sign in</a></p>
    <% } else { %>
      <p class="sub">Enter your admin email and we'll send you a link to reset your password.</p>
      <% if (error) { %>
        <div class="error-banner"><%= error %></div>
      <% } %>
      <form method="POST" action="/admin/forgot-password">
        <div class="form-grid">
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autofocus />
          </div>
          <button class="btn" type="submit" style="width:100%;">Send reset link</button>
        </div>
      </form>
      <p class="login-links"><a href="/admin/login">Back to sign in</a></p>
    <% } %>
  </div>
</div>
</body>
</html>
