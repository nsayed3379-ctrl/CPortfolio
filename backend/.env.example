# ---- Server ----
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
# Comma separated list of origins allowed to call the public API (your Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# ---- PostgreSQL ----
# Either set DATABASE_URL, or the individual PG_* vars below.
DATABASE_URL=postgres://vecosoft:vecosoft@localhost:5432/vecosoft
PGSSL=false

# ---- Auth ----
# Random long string used to sign admin JWTs / session cookies.
JWT_SECRET=change-this-to-a-long-random-string
SESSION_SECRET=change-this-too-a-different-long-random-string
# Used only by `npm run seed` to create the first admin user.
SEED_ADMIN_EMAIL=admin@vecosoft.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=VecoSoft Admin

# ---- Uploads ----
# Local disk storage under /uploads by default. Swap UPLOAD_DIR or point
# your own reverse proxy / S3 later without changing application code much.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
