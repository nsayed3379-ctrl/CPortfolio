# ---- Server ----
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
# Comma separated list of origins allowed to call the public API (your Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# ---- PostgreSQL ----
# Either set DATABASE_URL, or the individual PG_* vars below.
DATABASE_URL=postgres://vecosoft:vecosoft@localhost:5432/vecosoft
PGSSL=false

# ---- Auth ----
# Random long string used to sign admin JWTs / session cookies.
JWT_SECRET=change-this-to-a-long-random-string
SESSION_SECRET=change-this-too-a-different-long-random-string
# Used only by `npm run seed` to create the first admin user.
SEED_ADMIN_EMAIL=admin@vecosoft.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=VecoSoft Admin

# ---- Uploads ----
# Local disk storage under /uploads by default. Swap UPLOAD_DIR or point
# your own reverse proxy / S3 later without changing application code much.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ---- Outbound Email (form-submission notifications) ----
# Any SMTP provider works — Zoho Mail's free plan, Google Workspace, your
# domain host's cPanel webmail, etc. Leave SMTP_HOST empty to disable
# notification emails entirely; forms still save to the database either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VecoSoft Website <no-reply@vecosoft.com>"
# Where each form's notification lands — override individually if needed.
CONTACT_NOTIFY_EMAIL=hello@vecosoft.com
INQUIRY_NOTIFY_EMAIL=hello@vecosoft.com
CAREERS_NOTIFY_EMAIL=careers@vecosoft.com
